{
  "name": "Storify",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --quiet",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "create-admin": "node --env-file=.env scripts/create-admin.mjs",
    "link-credential": "node --env-file=.env scripts/link-credential.mjs",
    "db:seed": "tsx --env-file=.env scripts/seed.mjs",
    "db:seed:users": "tsx --env-file=.env scripts/seed-users.mjs",
    "db:reset": "tsx --env-file=.env scripts/reset.mjs",
    "db:full-reset": "tsx --env-file=.env scripts/reset.mjs && tsx --env-file=.env scripts/seed.mjs",
    "db:migrate:indexes": "node --env-file=.env scripts/migrate-product-review-indexes.mjs",
    "db:migrate:indexes:dry": "node --env-file=.env scripts/migrate-product-review-indexes.mjs --dry-run",
    "db:migrate:barcodes": "tsx --env-file=.env scripts/backfill-barcode-registry.ts",
    "db:migrate:barcodes:dry": "tsx --env-file=.env scripts/backfill-barcode-registry.ts --dry-run",
    "push:keys": "web-push generate-vapid-keys"
